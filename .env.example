# ==================================================
# SERVER ENVIRONMENT VARIABLES (server/.env)
# ==================================================
PORT=5000
NODE_ENV=development
# Required in production; exact browser origins shared by HTTP and Socket.IO.
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/athlix
JWT_SECRET=your_secret_here
# Internal video service. Generate one random secret (at least 32 characters)
# and set the same value ONLY on the Node and Python servers. Never NEXT_PUBLIC_.
CV_SERVICE_URL=http://127.0.0.1:8000
CV_SERVICE_API_KEY=
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Firebase Admin SDK (server/.env) ──────────────────────────────────────────
# 1. Go to: Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download JSON
# 3. Paste the entire JSON content as a single line below
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ==================================================
# CLIENT ENVIRONMENT VARIABLES (client/.env.local)
# ==================================================
# Backend API URL (Next.js dev → Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional verified support mailbox. Opens a user-sent email draft; no mail API.
# When unset, /contact explicitly disables email submission.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Firebase Client SDK (client/.env.local) ───────────────────────────────────
# 1. Go to: Firebase Console → Project Settings → Your apps → Web app
# 2. Copy the firebaseConfig values below
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Set to 'true' to use the Firebase Auth Emulator in local dev (optional)
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# ── Featherless AI ───────────────────────────────────────────────────────────
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2

# Python CV worker environment (see cv-service/README.md):
# CV_SERVICE_API_KEY=<same secret as server; at least 32 characters>
# CV_MODEL_PATH=/absolute/path/to/reviewed/pose_landmarker_heavy.task
# CV_TEMP_DIR=/private/writable/athlix-cv
